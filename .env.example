# ========================================================
# Heirest E-Commerce - Production Environment Configuration
# ========================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_2026
POSTGRES_DB=heirest_jewelry

# JWT Authentication Secret (use a random string >= 32 chars)
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_production_2026

# Allowed Frontend Origins for CORS (use * or your EC2 IP / domain name, comma-separated)
FRONTEND_URL=*

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_HeirestDemoKey2026
RAZORPAY_KEY_SECRET=heirest_razorpay_test_secret_2026
RAZORPAY_WEBHOOK_SECRET=heirest_webhook_secret_2026

# Database Auto-Seeding (seeds demo catalog and admin credentials on first startup)
AUTO_SEED=true

# Frontend API URL (Leave blank to use Nginx reverse proxy automatically)
VITE_API_URL=

# Optional: ECR Container Images (populated automatically by CI/CD pipeline on EC2)
# BACKEND_IMAGE=<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/heirest-backend:latest
# FRONTEND_IMAGE=<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/heirest-frontend:latest
